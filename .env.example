# ==============================================================================
# Insurance & Healthcare Conversational AI Platform - Environment Variables
# ==============================================================================

# Server Configuration
SERVER_IP_ADDRESS=0.0.0.0
SERVER_PORT_ADDRESS=5559

# Application Execution Approach
# 1 = Direct Contextualized Vector RAG + Text-2-SQL
# 2 = Graph-Augmented Schema Linking (NetworkX) + LangGraph Text-2-SQL
APPROACH=1

# Model Provider Selection
# 1 = Local Ollama LLM
# 2 = Cloud / Nebius / Krutrim / OpenAI compatible API
MODEL=1

# Vector Database Selection
# 1 = ChromaDB (Local persistent)
# 2 = Qdrant (High-performance vector engine)
VECTOR_DB=2

# Primary MySQL Relational Database (Target Data Store)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=insurance_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Local Auth & Session Metadata Databases
DATABASE_URL=sqlite:///./chatbot.db
SYNC_DB_URL=sqlite:///./memory.db

# Ollama LLM Configuration (Local Inference)
OLLAMA_MAIN_MODEL=qwen2.5-coder:14b-instruct-q8_0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.05
OLLAMA_NUM_CTX=20000

# Greeting & Conversational Routing LLM
GREETINGS_MAIN_MODEL=llama3.2:3b-instruct-q4_0
GREETINGS_BASE_URL=http://localhost:11434
GREETINGS_TEMPERATURE=0.02
GREETINGS_NUM_CTX=8192

# Cloud / Nebius / Krutrim LLM Configuration (Alternative to Ollama)
KRUTRIM_MAIN_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
KRUTRIM_BASE_URL=https://api.studio.nebius.com/v1
KRUTRIM_TEMPERATURE=0.05
KRUTRIM_API_KEY=your_cloud_llm_api_key_here
KRUTRIM_NUM_CTX=20000

KRUTRIM_INSTRUCTION_MODEL=meta-llama/Llama-3.3-70B-Instruct
KRUTRIM_INSTRUCTION_BASE_URL=https://api.studio.nebius.com/v1
KRUTRIM_INSTRUCTION_TEMPERATURE=0.6
KRUTRIM_INSTRUCTION_NUM_CTX=8192
KRUTRIM_INSTRUCTION_API_KEY=your_instruction_llm_api_key_here

# HuggingFace & Embedding Models
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HUGGINGFACE_TOKEN=your_huggingface_token_here

# LangSmith Observability & Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=Insurance_Text_2_SQL

# JWT & Authentication Security
JWT_SECRET_KEY=generate_a_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
PASSWORD_SECRET=GenerateSecureSalt123

# Retrieval & Threshold Tuning
FAQS_THRESHOLD=0.90
FAQS_CHROMADB_DISTANCE=0.40
API_THRESHOLD=0.58
API_CHROMADB_DISTANCE=0.40
MAINTAIN_CONVERSATION_HISTORY_COUNT=10
